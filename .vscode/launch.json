{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build navmap-pathfinder (win32)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo build --locked --target i686-pc-windows-msvc",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Build navmap-pathfinder (win64)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo build --locked --target x86_64-pc-windows-msvc --features allow_non_32bit",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Build navmap-pathfinder (win32 Tracy)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo build --release --locked --target i686-pc-windows-msvc --features tracy",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Build navmap-pathfinder (linux32)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cross build --locked --target i686-unknown-linux-gnu",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Build navmap-pathfinder (linux64)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cross build --locked --target x86_64-unknown-linux-gnu --features allow_non_32bit",
            "cwd": "${workspaceFolder}"
        }
    ]
}
